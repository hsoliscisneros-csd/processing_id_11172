      "suggested": {
        "train_grids": [
          "1_0",
          "1_1"
        ],
        "val_grids": [
          "0_1"
        ],
        "test_grids": [
          "0_0"
        ]
      },
      "assignment": "bssid_median_latlon_one_grid",
      "status": "stress_test",
      "notes": "non_isolate → n_test≈0 (sin aristas train hacia OOD). subgraph=all → n_test=4733 models collapse (PR-AUC=prevalence, ROC=0.5). P3 documents an inductive limit; paper protocol = P1."
    }
  },
