        "Tuxtla Gutiérrez",
        "Suchiapa",
        "Chiapa de Corzo",
        "Jardines del Grijalva"
      ],
      "val_municipalities": [
        "Las Flechas"
      ],
      "test": "all_other_municipalities_in_state",
      "notes": "Mismo protocolo EXP-06 / physagg --split spatial",
      "known_issue": "val Las Flechas ~435 obs / ~57 nodos noniso — umbral inestable"
    },
    "P2_loo_metro": {
      "type": "leave_one_municipality_out",
      "pool": [
        "Tuxtla Gutiérrez",
        "Suchiapa",
        "Chiapa de Corzo",
        "Jardines del Grijalva"
      ],
      "min_val_obs": 200,
      "test": "municipalities_outside_pool",
      "fn": "src.evaluation.splits.spatial_loo_folds"
    },
    "P3_grid_2x2": {
      "type": "geo_grid",
      "lat_median": 16.730386,
      "lon_median": -93.089303,
