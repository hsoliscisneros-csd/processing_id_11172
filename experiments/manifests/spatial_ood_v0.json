    "description": "Gap espacial Δ = PR-AUC_temporal - PR-AUC_spatial",
    "pass_if": "method reduces Δ by ≥10% relative vs A0 SAGE, or wins in ≥2 LOO folds",
    "baseline_ref": "experiments/outputs/physagg + physagg/spatial"
  },
